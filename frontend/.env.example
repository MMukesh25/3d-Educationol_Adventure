# =============================================================================
# 3D Educational Adventure Platform — Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env files with real secrets!

# Backend API Base URL (used in production builds)
VITE_API_BASE_URL=http://localhost:8080/api

# Vite Dev Server Port
VITE_DEV_PORT=5173

# Enable 3D Three.js performance monitoring (dev only)
VITE_PERF_MONITOR=false

# Sound effects toggle (true = enabled by default)
VITE_SOUND_ENABLED=true

# Default theme color for the platform UI
VITE_PRIMARY_COLOR=#ff6b6b
